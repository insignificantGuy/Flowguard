# flowguard environment configuration
# Copy to .env and edit as needed.
# All values here are defaults; the app will start with these if .env is absent.

# Deployment environment: development | staging | production
ENV=development

# HTTP server bind address and port
HOST=0.0.0.0
PORT=3000

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Rate limiter: max requests per key per window
RATE_LIMIT_MAX=100
# Rate limiter window in milliseconds
RATE_LIMIT_TTL_MS=60000

# Redis URL for distributed rate limiting across instances.
# When empty (default), an in-memory limiter is used (single-process only).
# REDIS_URL=redis://localhost:6379
# Kafka configuration for the send-message endpoint.
# The endpoint publishes to KAFKA_TOPIC with the message as both key and value.
# When KAFKA_BROKERS is empty, the producer is disabled and /v1/send-message
# returns 503 SERVICE_UNAVAILABLE.
KAFKA_BROKERS=
# Topic to publish to (default: RECONCILIATION)
KAFKA_TOPIC=RECONCILIATION
# How long Publish waits for a broker ack, in milliseconds (default: 5000)
KAFKA_TIMEOUT_MS=5000

# Explicit comparison toggles (change on server, not on the load generator)
DISABLE_BACKPRESSURE=false
DISABLE_CIRCUIT_BREAKER=false
# Queue capacity counts waiting jobs; outstanding also includes running workers.
BACKPRESSURE_MAX_QUEUE_DEPTH=512
BACKPRESSURE_PAUSE_AFTER_DEPTH=32
BACKPRESSURE_RESUME_AFTER_DEPTH=8
CONSUMER_MAX_CONCURRENCY=4
HANDLER_PROCESSING_MS=50
