# flowguard environment configuration
# Copy to .env and edit as needed.
# All values here are defaults; the app will start with these if .env is absent.

# Deployment environment: development | staging | production
ENV=development

# HTTP server bind address and port
HOST=0.0.0.0
PORT=3000

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Rate limiter: max requests per key per window
RATE_LIMIT_MAX=100
# Rate limiter window in milliseconds
RATE_LIMIT_TTL_MS=60000

# Redis URL for distributed rate limiting across instances.
# When empty (default), an in-memory limiter is used (single-process only).
# REDIS_URL=redis://localhost:6379